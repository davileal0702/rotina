{
  "manifest_version": 3,
  "name": "Rotina",
  "version": "0.1.0",
  "description": "Durante uma atividade do Rotina, só abre os sites liberados para ela.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["declarativeNetRequest", "tabs", "storage", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
