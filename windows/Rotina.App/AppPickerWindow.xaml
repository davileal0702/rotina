<Window x:Class="Rotina.App.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar apps" Height="560" Width="520" MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Adicionar apps" Style="{StaticResource H2}"/>
            <TextBlock Text="Marque os apps que ficam liberados. A lista vem do Menu Iniciar e dos apps abertos agora."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <Label Content="_Buscar" Target="{Binding ElementName=SearchBox}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="Procurar .exe..." Style="{StaticResource SecondaryButton}" Click="Browse_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <Button x:Name="AddButton" Content="Adicionar" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="Add_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,12,0,0">
            <ListBox x:Name="AppList" Style="{StaticResource CardList}" AutomationProperties.Name="Apps encontrados">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Checked}" Cursor="Hand" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="{Binding App.Name}">
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <Image Source="{Binding App.Icon}" Width="24" Height="24" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding App.Path}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Text="Carregando apps..."/>
        </Grid>
    </DockPanel>
</Window>
