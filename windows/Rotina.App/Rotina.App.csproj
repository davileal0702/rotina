<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rotina.Core\Rotina.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For app icons now and the tray icon in phase 2. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>rotina.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated from docs/brand/rotina-icon.png. -->
    <Resource Include="rotina.ico" />
    <Resource Include="rotina-64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF names (MessageBox, Application, Color) unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
