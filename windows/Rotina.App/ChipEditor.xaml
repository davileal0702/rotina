<UserControl x:Class="Rotina.App.ChipEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ItemsControl x:Name="ChipItems" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Chip}" ToolTip="{Binding Value}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource ChipRemove}" Tag="{Binding}" Click="Remove_Click"
                                    AutomationProperties.Name="{Binding Label, StringFormat=Remover {0}}"
                                    ToolTip="Remover"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyText" Text="Nenhum item." Style="{StaticResource Caption}" Margin="0,0,0,8"/>

        <Button x:Name="AppButton" Content="Adicionar apps..." Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Left" Click="PickApps_Click" Visibility="Collapsed"/>

        <StackPanel x:Name="InputRow" Orientation="Horizontal">
            <TextBox x:Name="InputBox" Width="260" KeyDown="InputBox_KeyDown"/>
            <Button Content="Adicionar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Add_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
